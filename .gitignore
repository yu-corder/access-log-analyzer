# ===== アクセスログ（IP アドレス・UA などの個人情報を含む）=====
logs/*
!logs/.gitkeep
*.log
*.log.*
*.gz
access.log*
# テスト用のサンプルログは公開してよい（RFC 5737 等のドキュメント用 IP のみ使用）
!tests/fixtures/*

# ===== 集計結果（IP アドレスを含む）=====
report*.json
report*.csv
reports/

# ===== 認証情報・接続設定（将来の SSH 取得機能用を含む）=====
config.toml
!config.example.toml
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
*.ppk
secrets/
# SSH 接続設定・本番サーバの情報（ホスト名・IP・ユーザー名・ポート）
# → 公開リポジトリには *.example.* のダミー値だけを置く
.ssh/
ssh_config
*.ssh_config
servers.*
!servers.example.*
hosts.*
!hosts.example.*
inventory*
*.local.*
*.local
*.ovpn
# サーバから取得したデータのダンプ類
*.sql
*.sql.gz
*.dump

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ===== OS / エディタ =====
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
*.swp
